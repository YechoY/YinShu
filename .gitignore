# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境与依赖
.venv/
node_modules/

# 测试临时目录（本机 gettempdir 异常，测试空间统一放这）
tmp/

# 插件构建产物
plugins/ceru-webdav-sync/dist/
plugins/ceru-webdav-sync/release/plugin.js
# 澜音插件目录是**独立 git 仓库**（有自己的 .git），单独管理，不并入本仓库
plugins/ceru-webdav-sync/

# 配置备份（config.json 含密码，同样不入库）
backups/
config.json.bak*

# 运行时数据（真实同步数据，不入库）
data/spaces/

# 本地账号配置（含密码，不入库；网页端账号管理会自动创建/写回）
config.json

# 内部过程文档与历史归档（仅本地留存，不入库；需要时按 git 历史找回）
docs/0[1-9]-*.md
docs/1[01]-*.md
docs/archive/
docs/notes/
docs/栖弦客户端适配修改方案.md

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 一次性排查 / 复现脚本（不是产品代码，仅本地留存）
scripts/
